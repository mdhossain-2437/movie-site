# ==============================================================================
# Cinematic Graphite — Environment Configuration Template (.env.example)
# Copy to .env.local for local development. NEVER commit real secrets or keys.
# ==============================================================================

NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info
DEFAULT_TERRITORY=BD

# Database & Cache (Optional in M1; local PGlite fallback or Docker Compose in M2)
DATABASE_URL=postgresql://movie_app:replace_with_local_dev_password@127.0.0.1:5432/movie_platform
REDIS_URL=redis://127.0.0.1:6379

# Independent Cryptographic Secrets (MUST be distinct >=32-byte random strings in production)
SESSION_SECRET=replace_with_32_plus_char_session_secret_for_local_dev
MEDIA_SIGNING_SECRET=replace_with_32_plus_char_independent_media_signing_secret
TOKEN_ENCRYPTION_KEY=replace_with_32_plus_char_token_encryption_key_material

# Private Object Storage Adapter ("memory" | "r2" | "s3-compatible")
# Note: "memory" is blocked automatically when effective stage is production.
OBJECT_STORAGE_PROVIDER=memory
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET_SOURCE=media-source-private
OBJECT_STORAGE_BUCKET_STAGING=media-staging-private
OBJECT_STORAGE_BUCKET_PACKAGED=media-packaged-private
OBJECT_STORAGE_BUCKET_ARTWORK=media-artwork-public
OBJECT_STORAGE_BUCKET_BACKUP=media-backup-vault
# OBJECT_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Managed Video / Packaging Provider ("none" | "mux" | "cloudflare-stream" | "aws-mediaconvert")
VIDEO_PROVIDER=none
# VIDEO_PROVIDER_ACCOUNT_ID=
# VIDEO_PROVIDER_API_TOKEN=

# Metadata Attribution (TMDb commercial use blocked unless license confirmed)
# TMDB_API_KEY=
TMDB_COMMERCIAL_LICENSE_CONFIRMED=false

# Upload & Temporary Quarantine Limits (bytes)
UPLOAD_MAX_BYTES=53687091200
TEMP_STORAGE_MAX_BYTES=21474836480

# Optional Error Telemetry
# SENTRY_DSN=
